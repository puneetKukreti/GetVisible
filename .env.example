# ==============================================================================
# LeadForge AI - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION MODE & DEMO SWITCH
# ------------------------------------------------------------------------------
# Set to 'true' ONLY for explicit local demo/testing mode without a live PostgreSQL database.
# In production, set to 'false' or leave unset. Production will NEVER silently fall back
# to fake data and will raise explicit connection errors if PostgreSQL is unreachable.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Required in production. Connects to Supabase, Neon, AWS RDS, or local PostgreSQL.
# Example: postgresql://postgres:password@localhost:5432/leadforge_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadforge_ai?schema=public"

# Optional: direct (non-pooled) connection string used for schema migrations.
# Vercel Postgres / Neon inject this automatically; scripts/migrate-deploy.mjs
# prefers it because pooled endpoints cannot run `prisma migrate`.
DATABASE_URL_UNPOOLED=""

# Days a public demo link stays alive after creation (default: 3).
DEMO_PUBLIC_TTL_DAYS="3"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Secret used to sign owner session tokens and NextAuth JWTs.
# REQUIRED in production (>= 16 chars). Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Password for the single-operator owner workbench (/login).
# REQUIRED and must be at least 8 characters. There is NO default password;
# if unset, login fails closed with HTTP 503.
ADMIN_PASSWORD=""

# Optional explicit demo-mode login credential for NextAuth (only honoured when
# DEMO_MODE=true). Never used in production.
DEMO_ADMIN_PASSWORD=""

# When 'true', the x-organization-id request header is trusted for tenancy.
# Leave unset in production so clients cannot select an arbitrary organization.
TRUST_ORG_HEADER="false"

# Shared secret sent by Vercel Cron as `Authorization: Bearer <CRON_SECRET>` when
# calling /api/cron/prune-demos. When unset, that (idempotent) endpoint stays open.
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 3b. PROSPECT-FACING CONTACT DETAILS
# ------------------------------------------------------------------------------
# Owner WhatsApp number shown on the public "Claim on WhatsApp" bar of every
# website concept. Digits only, including the country code (e.g. 919812345678).
# There is NO placeholder fallback: when unset, the claim bar is hidden so a
# prospect can never message a stranger. NEXT_PUBLIC_AGENCY_WHATSAPP is accepted
# as a legacy alias.
NEXT_PUBLIC_PUNEET_WHATSAPP=""

# ------------------------------------------------------------------------------
# 4. AI PROVIDER (Google Gemini API)
# ------------------------------------------------------------------------------
# Used exclusively for reasoning tasks: website interpretation, opportunity analysis,
# personalized value proposition drafts, and response classification.
# AI is NEVER used for basic database CRUD, search, filter, sort, or pagination.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4b. DEMO DESIGN & IMAGERY (optional opt-outs)
# ------------------------------------------------------------------------------
# Trades with no curated design get a per-industry design blueprint, and their
# photos are searched live on the web (Openverse, no key needed). Both are
# skipped under NODE_ENV=test.
# 'true' keeps curated/default photos instead of searching the live web.
DISABLE_LIVE_IMAGES=""
# 'true' skips the model call that authors an industry blueprint; the curated
# deterministic blueprint for that industry is used instead.
DISABLE_INDUSTRY_BLUEPRINT_AI=""

# ------------------------------------------------------------------------------
# 5. BUSINESS LEAD EXTRACTOR & DISCOVERY PROVIDERS
# ------------------------------------------------------------------------------
# Google Places API (Places Text Search & Place Details)
# If set, enables direct Google Places API business discovery with addresses, ratings & phone numbers.
GOOGLE_PLACES_API_KEY=""

# Live Search & Business Directory Engines (Optional external live search APIs)
# If provided, LiveWebSearchProvider can query Google via SerpAPI, Google CSE, or Tavily AI.
SERPAPI_API_KEY=""
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""
TAVILY_API_KEY=""

# Enable/disable live web search crawling (default true)
ENABLE_LIVE_WEB_SEARCH="true"

# Licensed Public Registry API (Optional)
PUBLIC_REGISTRY_API_KEY=""

# ------------------------------------------------------------------------------
# 6. EXTERNAL SERVICES
# ------------------------------------------------------------------------------
PAGESPEED_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
VERCEL_TOKEN=""
