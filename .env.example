# ==============================================================================
# LeadForge AI - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION MODE & DEMO SWITCH
# ------------------------------------------------------------------------------
# Set to 'true' ONLY for explicit local demo/testing mode without a live PostgreSQL database.
# In production, set to 'false' or leave unset. Production will NEVER silently fall back
# to fake data and will raise explicit connection errors if PostgreSQL is unreachable.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Required in production. Connects to Supabase, Neon, AWS RDS, or local PostgreSQL.
# Example: postgresql://postgres:password@localhost:5432/leadforge_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadforge_ai?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (NextAuth / Auth.js)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. AI PROVIDER (Google Gemini API)
# ------------------------------------------------------------------------------
# Used exclusively for reasoning tasks: website interpretation, opportunity analysis,
# personalized value proposition drafts, and response classification.
# AI is NEVER used for basic database CRUD, search, filter, sort, or pagination.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. EXTERNAL PROVIDERS (Phase 2 Roadmap)
# ------------------------------------------------------------------------------
# If unconfigured, the system explicitly reports "Provider not configured"
# and will never simulate false success in production.
PUBLIC_REGISTRY_API_KEY=""
PAGESPEED_API_KEY=""
RESEND_API_KEY=""
VERCEL_TOKEN=""
